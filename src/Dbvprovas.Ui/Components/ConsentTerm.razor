@* Termo do consentimento próprio do adulto (RN-PRV-002, S-073, D-095). *@
<fieldset class="consent-term">
    <legend>Termo de participação</legend>
    <p>Ao enviar, você consente em participar do @ClubName e autoriza o clube a usar os seus dados de cadastro conforme as regras do app. Você pode revogar quando quiser, em Minha participação.</p>
    <p class="consent-version">Versão do termo: @Labels.TermVersion(ConsentTerms.AdultOwnParticipationVersion)</p>
    <label>
        <input type="checkbox" checked="@Accepted" @onchange="ChangedAsync" />
        Li e aceito o termo.
    </label>
</fieldset>

@code {
    [Parameter, EditorRequired]
    public string ClubName { get; set; } = string.Empty;

    [Parameter]
    public bool Accepted { get; set; }

    [Parameter]
    public EventCallback<bool> AcceptedChanged { get; set; }

    private Task ChangedAsync(ChangeEventArgs e) => AcceptedChanged.InvokeAsync(e.Value is true);
}
