<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Dbvprovas.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <ApplicationTitle>dbvprovas</ApplicationTitle>
    <ApplicationId>io.github.gustavo0101.dbvprovas</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- O MAUI Blazor Hybrid exige Android 7.0 (API 24) ou mais novo (D-121). -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Versão do Microsoft.Maui.Controls cujo nome interno do arquivo de preferências do SecureStorage foi conferido (RNF-TEN-004). -->
    <VerifiedMauiVersion>10.0.110</VerifiedMauiVersion>
  </PropertyGroup>
  <!--
    O SecureSessionStore apaga por nome o arquivo do SecureStorage do MAUI, um alias interno que pode mudar numa atualização.
    Se a versão do pacote (Directory.Packages.props) diferir da conferida, o build para: reconfira o nome em SecureSessionStore
    e atualize VerifiedMauiVersion.
  -->
  <Target Name="CheckMauiVersionForSecureStorage" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_CurrentMauiVersion>@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Maui.Controls')->'%(Version)')</_CurrentMauiVersion>
    </PropertyGroup>
    <Error Condition="'$(_CurrentMauiVersion)' != '$(VerifiedMauiVersion)'"
           Text="A versão do Microsoft.Maui.Controls ($(_CurrentMauiVersion)) difere da conferida ($(VerifiedMauiVersion)). Reconfira o nome do arquivo de preferências do SecureStorage em SecureSessionStore.cs e atualize VerifiedMauiVersion em Dbvprovas.App.csproj (RNF-TEN-004)." />
  </Target>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dbvprovas.Ui\Dbvprovas.Ui.csproj" />
  </ItemGroup>
</Project>
